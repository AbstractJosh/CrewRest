DATABASE_URL="file:./dev.db"

# Live TCDD timetable. Leave TCDD_API_BASE_URL empty and the app falls back to the curated
# timetable in src/lib/trains/data/ — exactly how it behaved before the integration existed.
TCDD_API_BASE_URL=""
TCDD_API_TOKEN=""
# Path appended to the base URL for a timetable search. Defaults to /search.
TCDD_API_SEARCH_PATH=""

# JSON overriding the built-in station-code mapping, e.g. {"IST":"1234","ESK":"5678"}.
# Only needed if the API wants ids rather than the station names in data/tcddStations.ts.
TCDD_STATION_IDS=""

# Deep link into ebilet with the trip prefilled. ebilet is a single-page app with no documented
# link format, so this is empty by default and the "Buy on TCDD" links go to the plain search
# page. Run a search on ebilet, copy the resulting URL, and substitute the placeholders:
#   TCDD_BOOKING_URL_TEMPLATE="https://ebilet.tcddtasimacilik.gov.tr/?from={from}&to={to}&date={date}"
# Placeholders: {from} {to} (station ids), {date} (YYYY-MM-DD), {time} (HH:MM local).
TCDD_BOOKING_URL_TEMPLATE=""
